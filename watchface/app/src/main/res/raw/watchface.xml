<?xml version="1.0" encoding="utf-8"?>
<!--
  Neon Beach - Watch Face Format (WFF) v1, canvas 450x450.
  Original artwork; bitmaps are generated by tools/generate_assets.py.
  Theme colours below must stay in sync with THEMES in that script.
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <UserConfigurations>
    <ListConfiguration id="background" displayName="cfg_background" defaultValue="sunset">
      <ListOption id="sunset" displayName="cfg_background_sunset" icon="ic_option_sunset" />
      <ListOption id="night" displayName="cfg_background_night" icon="ic_option_night" />
    </ListConfiguration>
    <ColorConfiguration id="themeColor" displayName="cfg_color" defaultValue="0">
      <ColorOption id="0" displayName="cfg_color_pink" colors="#FFFF3D9A #FF00E5FF" />
      <ColorOption id="1" displayName="cfg_color_cyan" colors="#FF00E5FF #FFFF3D9A" />
      <ColorOption id="2" displayName="cfg_color_gold" colors="#FFFFC23D #FFFF3D9A" />
      <ColorOption id="3" displayName="cfg_color_white" colors="#FFFFFFFF #FF00E5FF" />
      <ColorOption id="4" displayName="cfg_color_green" colors="#FF39FF88 #FFFFC23D" />
    </ColorConfiguration>
    <BooleanConfiguration id="showSeconds" displayName="cfg_seconds" defaultValue="TRUE" />
  </UserConfigurations>

  <Scene backgroundColor="#FF000000">

    <!-- ===== Interactive (active) mode ===== -->
    <Group name="active" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <ListConfiguration id="background">
        <ListOption id="sunset">
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bg_sunset" />
          </PartImage>
        </ListOption>
        <ListOption id="night">
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="bg_night" />
          </PartImage>
        </ListOption>
      </ListConfiguration>

      <BooleanConfiguration id="showSeconds">
        <BooleanOption id="TRUE">
          <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="7" y="7" width="436" height="436">
              <Stroke color="#28FFFFFF" thickness="3" />
            </Ellipse>
            <Arc centerX="225" centerY="225" width="436" height="436" startAngle="0" endAngle="0">
              <Transform target="endAngle" value="[SECOND] * 6" />
              <Stroke color="[CONFIGURATION.themeColor.1]" thickness="6" cap="ROUND" />
            </Arc>
          </PartDraw>
        </BooleanOption>
      </BooleanConfiguration>

      <Group name="date_active" x="0" y="0" width="450" height="450">
        <Condition>
          <Expressions>
            <Expression name="d1"><![CDATA[[DAY_OF_WEEK] == 1]]></Expression>
            <Expression name="d2"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
            <Expression name="d3"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
            <Expression name="d4"><![CDATA[[DAY_OF_WEEK] == 4]]></Expression>
            <Expression name="d5"><![CDATA[[DAY_OF_WEEK] == 5]]></Expression>
            <Expression name="d6"><![CDATA[[DAY_OF_WEEK] == 6]]></Expression>
          </Expressions>
          <Compare expression="d1">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[DOM]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d2">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[SEG]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d3">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[TER]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d4">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[QUA]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d5">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[QUI]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d6">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[SEX]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Default>
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]"><![CDATA[SÁB]]></Font>
                </Text>
              </PartText>
          </Default>
        </Condition>
        <PartText x="232" y="64" width="128" height="30">
          <Text align="START">
            <Font family="orbitron_medium" size="22" color="[CONFIGURATION.themeColor.1]">
              <Template>%s.%s<Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_Z]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Group>

      <DigitalClock x="0" y="100" width="450" height="100">
        <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="100">
          <Font family="orbitron_bold" size="96" color="[CONFIGURATION.themeColor.0]" />
        </TimeText>
      </DigitalClock>
    </Group>

    <!-- ===== Complications (hidden in ambient) ===== -->
    <ComplicationSlot slotId="0" x="114" y="290" width="92" height="92"
        supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY" isCustomizable="TRUE">
      <BoundingOval x="0" y="0" width="92" height="92" />
      <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
      <Complication type="SHORT_TEXT">
        <Group name="c" x="0" y="0" width="92" height="92">
          <Variant mode="AMBIENT" target="alpha" value="0" />
        <PartDraw x="0" y="0" width="92" height="92">
          <Ellipse x="1" y="1" width="90" height="90">
            <Fill color="#AA050010" />
            <Stroke color="[CONFIGURATION.themeColor.1]" thickness="2" />
          </Ellipse>
        </PartDraw>
        <PartImage x="34" y="14" width="24" height="24" tintColor="[CONFIGURATION.themeColor.0]">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="4" y="44" width="84" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="orbitron_medium" size="22" color="#FFFFFFFF">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
        </Group>
      </Complication>
      <Complication type="RANGED_VALUE">
        <Group name="c" x="0" y="0" width="92" height="92">
          <Variant mode="AMBIENT" target="alpha" value="0" />
        <PartDraw x="0" y="0" width="92" height="92">
          <Ellipse x="1" y="1" width="90" height="90">
            <Fill color="#AA050010" />
            <Stroke color="#40FFFFFF" thickness="2" />
          </Ellipse>
          <Arc centerX="46" centerY="46" width="88" height="88" startAngle="0" endAngle="0">
            <Transform target="endAngle"
                value="clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 360" />
            <Stroke color="[CONFIGURATION.themeColor.1]" thickness="4" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartImage x="34" y="14" width="24" height="24" tintColor="[CONFIGURATION.themeColor.0]">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="4" y="44" width="84" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="orbitron_medium" size="22" color="#FFFFFFFF">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
        </Group>
      </Complication>
    </ComplicationSlot>

    <ComplicationSlot slotId="1" x="244" y="290" width="92" height="92"
        supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY" isCustomizable="TRUE">
      <BoundingOval x="0" y="0" width="92" height="92" />
      <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
      <Complication type="SHORT_TEXT">
        <Group name="c" x="0" y="0" width="92" height="92">
          <Variant mode="AMBIENT" target="alpha" value="0" />
        <PartDraw x="0" y="0" width="92" height="92">
          <Ellipse x="1" y="1" width="90" height="90">
            <Fill color="#AA050010" />
            <Stroke color="[CONFIGURATION.themeColor.1]" thickness="2" />
          </Ellipse>
        </PartDraw>
        <PartImage x="34" y="14" width="24" height="24" tintColor="[CONFIGURATION.themeColor.0]">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="4" y="44" width="84" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="orbitron_medium" size="22" color="#FFFFFFFF">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
        </Group>
      </Complication>
      <Complication type="RANGED_VALUE">
        <Group name="c" x="0" y="0" width="92" height="92">
          <Variant mode="AMBIENT" target="alpha" value="0" />
        <PartDraw x="0" y="0" width="92" height="92">
          <Ellipse x="1" y="1" width="90" height="90">
            <Fill color="#AA050010" />
            <Stroke color="#40FFFFFF" thickness="2" />
          </Ellipse>
          <Arc centerX="46" centerY="46" width="88" height="88" startAngle="0" endAngle="0">
            <Transform target="endAngle"
                value="clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1) * 360" />
            <Stroke color="[CONFIGURATION.themeColor.1]" thickness="4" cap="ROUND" />
          </Arc>
        </PartDraw>
        <PartImage x="34" y="14" width="24" height="24" tintColor="[CONFIGURATION.themeColor.0]">
          <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
        </PartImage>
        <PartText x="4" y="44" width="84" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="orbitron_medium" size="22" color="#FFFFFFFF">
              <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
            </Font>
          </Text>
        </PartText>
        </Group>
      </Complication>
    </ComplicationSlot>

    <!-- ===== Always-on (ambient) mode: black background, low pixel count ===== -->
    <Group name="ambient" x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Group name="date_ambient" x="0" y="0" width="450" height="450">
        <Condition>
          <Expressions>
            <Expression name="d1"><![CDATA[[DAY_OF_WEEK] == 1]]></Expression>
            <Expression name="d2"><![CDATA[[DAY_OF_WEEK] == 2]]></Expression>
            <Expression name="d3"><![CDATA[[DAY_OF_WEEK] == 3]]></Expression>
            <Expression name="d4"><![CDATA[[DAY_OF_WEEK] == 4]]></Expression>
            <Expression name="d5"><![CDATA[[DAY_OF_WEEK] == 5]]></Expression>
            <Expression name="d6"><![CDATA[[DAY_OF_WEEK] == 6]]></Expression>
          </Expressions>
          <Compare expression="d1">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[DOM]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d2">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[SEG]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d3">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[TER]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d4">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[QUA]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d5">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[QUI]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Compare expression="d6">
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[SEX]]></Font>
                </Text>
              </PartText>
          </Compare>
          <Default>
              <PartText x="90" y="64" width="128" height="30">
                <Text align="END">
                  <Font family="orbitron_medium" size="22" color="#FFAAAAAA"><![CDATA[SÁB]]></Font>
                </Text>
              </PartText>
          </Default>
        </Condition>
        <PartText x="232" y="64" width="128" height="30">
          <Text align="START">
            <Font family="orbitron_medium" size="22" color="#FFAAAAAA">
              <Template>%s.%s<Parameter expression="[DAY_Z]" /><Parameter expression="[MONTH_Z]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Group>
      <DigitalClock x="0" y="100" width="450" height="100">
        <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="100">
          <Font family="orbitron_medium" size="96" color="#FFC8C8C8" />
        </TimeText>
      </DigitalClock>
    </Group>
  </Scene>
</WatchFace>
